# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The only email allowed to log into /admin
ADMIN_EMAIL=

# GitHub — a personal access token with public_repo read scope is enough
GITHUB_TOKEN=
GITHUB_USERNAME=

# Used to build absolute URLs for sitemap.xml / OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
